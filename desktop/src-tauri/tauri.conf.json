{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wispers Access",
  "identifier": "dev.wispers.access.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Wispers Access",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F7F7F2"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": "default-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Open the apps shared with you through Wispers Access",
    "longDescription": "Wispers Access lets you use web apps that someone shares with you, in your own browser, without exposing them to the internet. This app joins shares with an invitation code and opens their apps.",
    "copyright": "Copyright © 2026 Scheidegger Technology GmbH",
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "Developer ID Application"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMTdFRjYzNUYyQzkzQzcKUldUSGt5eGZZKzhYek5RTjFLSUlQYTB5WlFmei9Wci9aakxwZTNxd2J6amlGT1Q2ZjVhblBZSngK",
      "endpoints": [
        "https://raw.githubusercontent.com/s-te-ch/wispers-access/main/desktop/latest.json"
      ]
    }
  }
}
