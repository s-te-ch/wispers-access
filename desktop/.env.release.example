# Example for .env.release

# The updater key's password (see `tauri signer generate`).
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# Key location if not ~/.tauri/wispers-access-desktop.key.
#TAURI_SIGNING_PRIVATE_KEY=

# Notarisation, if not exported in the shell.
#APPLE_ID=
#APPLE_PASSWORD=
#APPLE_TEAM_ID=
