<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Light (weight 300) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="300"
        android:fontVariationSettings="'wght' 300"
        android:font="@font/nunito_sans" />

    <!-- Regular (weight 400) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400"
        android:font="@font/nunito_sans" />

    <!-- Medium (weight 500) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        android:font="@font/nunito_sans" />

    <!-- Bold (weight 700) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700"
        android:font="@font/nunito_sans" />

    <!-- ExtraBold (weight 800) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="800"
        android:fontVariationSettings="'wght' 800"
        android:font="@font/nunito_sans" />

    <!-- Black (weight 900) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="900"
        android:fontVariationSettings="'wght' 900"
        android:font="@font/nunito_sans" />

    <!-- Italic (weight 400 + ital) -->
    <font
        android:fontStyle="italic"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400,'ital' 1"
        android:font="@font/nunito_sans" />

    <!-- Bold Italic (weight 700 + ital) -->
    <font
        android:fontStyle="italic"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700,'ital' 1"
        android:font="@font/nunito_sans" />

</font-family>