<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The browsing tunnel serves each share over a loopback HTTP proxy the
	     WKWebView loads from (http://127.0.0.1:<port>/). Permit cleartext to the
	     loopback/local interfaces; everything else stays ATS-protected. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used to connect directly to shared apps on devices in your network.</string>
</dict>
</plist>
